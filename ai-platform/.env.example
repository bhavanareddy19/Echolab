# =============================================================================
# ECHOLAB ENVIRONMENT VARIABLES
# =============================================================================
# Copy this to .env and fill in your values:  cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=echolab
POSTGRES_PASSWORD=echolab_secret_2024
POSTGRES_DB=echolab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# --- API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
HF_TOKEN=hf_your-huggingface-token-here

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Supabase (Backend DB connection) ---
SUPABASE_DB_URL=postgresql+asyncpg://echolab:echolab_secret_2024@postgres:5432/echolab

# --- GrowthBook (A/B Testing) ---
GROWTHBOOK_API_URL=https://api.growthbook.io
GROWTHBOOK_PAT=your-growthbook-personal-access-token

# --- Zendesk Integration ---
ZENDESK_SUBDOMAIN=your-company
ZENDESK_EMAIL=admin@your-company.com
ZENDESK_API_TOKEN=your-zendesk-api-token
