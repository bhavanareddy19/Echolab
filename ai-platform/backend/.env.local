# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Use this when running the backend locally (outside Docker)
# The database services are still running in Docker
# =============================================================================

# --- PostgreSQL (connect to Docker container on localhost) ---
POSTGRES_USER=echolab
POSTGRES_PASSWORD=echolab_secret_2024
POSTGRES_DB=echolab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (connect to Docker container on localhost) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Qdrant (connect to Docker container on localhost) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
HF_TOKEN=hf_your-huggingface-token-here

# --- Supabase (Backend DB connection) ---
SUPABASE_DB_URL=postgresql+asyncpg://echolab:echolab_secret_2024@localhost:5432/echolab
